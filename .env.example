# Supabase (browser-safe — used by lib/supabase.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server only (Stripe webhook updates orders; never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Resend (contact form — server only)
RESEND_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From Stripe Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=

# Canonical public URL — used when the Stripe webhook calls `/api/send-order-confirmation` on this deploy.
NEXT_PUBLIC_SITE_URL=

# Password reset landing URL (must match Supabase Dashboard → Authentication → URL Configuration → Redirect URLs exactly).
# Override locally, e.g. http://localhost:3000/reset-password
# If reset emails fail: Auth → Email Templates (Reset Password), Providers → Email (SMTP), URL allowlist.
NEXT_PUBLIC_PASSWORD_RESET_REDIRECT_URL=

# Bearer token shared by the webhook route and `/api/send-order-confirmation`. Generate a random string; never expose client-side.
INTERNAL_ORDER_EMAIL_SECRET=

# Optional: fallback shared secret used by outbound internal APIs (see lib/send-order-confirmation-email.ts)
# INTERNAL_API_SECRET=

# Printify (product catalog — server only)
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Set to "true" to actually push paid orders to Printify's Orders API
# (lib/printify-order-fulfillment.ts) and enable live order tracking
# (/api/order-tracking). Leave unset/false in any environment where you don't
# want real Printify orders created (e.g. while testing checkout).
PRINTIFY_FULFILLMENT_ENABLED=

# Secret returned when registering a webhook against Printify's API (see
# app/api/printify-webhook/route.ts for the registration command). Lets
# catalog changes on Printify show up on the site within seconds instead of
# waiting for the 5-minute fallback cache.
PRINTIFY_WEBHOOK_SECRET=

# Password for /admin/* (product hide/show panel — see middleware.ts).
# Generate one with `openssl rand -hex 8` or set your own.
ADMIN_PANEL_PASSWORD=
